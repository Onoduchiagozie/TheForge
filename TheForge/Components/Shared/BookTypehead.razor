@using TheForge.Models

<div class="book-typeahead">
    <div class="filter-input-wrap">
        <svg class="filter-input__icon" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true">
            <path d="M5 4v16M10 4v16M15 5l4 14.5" />
        </svg>
        <input type="text"
               class="filter-input"
               autocomplete="off"
               placeholder="@Placeholder"
               disabled="@Disabled"
               value="@_text"
               @oninput="HandleInput"
               @onfocus="OpenList"
               @onblur="CloseList"
               @onkeydown="HandleKeyDown" />
    </div>

    @if (!string.IsNullOrEmpty(_text) && !Disabled)
    {
    <button type="button"
            class="book-typeahead__clear"
            aria-label="Clear book filter"
            @onmousedown="ClearSelection"
            @onmousedown:preventDefault="true">×</button>
    }

    @if (_open && !Disabled)
    {
    <ul class="book-typeahead__results" role="listbox">
        @if (Results.Count == 0)
        {
        <li class="book-typeahead__empty">No matching books</li>
        }
        @foreach (var book in Results)
        {
        <li>
            <button type="button"
                    class="book-typeahead__result @(book.Filename == _selectedFilename ? "book-typeahead__result--active" : "")"
                    role="option"
                    @onmousedown="() => Choose(book)"
                    @onmousedown:preventDefault="true">
                <span class="book-typeahead__title">@book.Title</span>
                @if (!string.IsNullOrWhiteSpace(book.Author))
                {
                <span class="book-typeahead__author">@book.Author</span>
                }
                <span class="book-typeahead__badge book-typeahead__badge--@BadgeKey(book)">@BadgeKey(book).Replace('_', ' ')</span>
            </button>
        </li>
        }
    </ul>
    }
</div>

@code {
private const int MaxResults = 50;
private static readonly HashSet<string> KnownBadges =
["horus_heresy", "novella", "short_story", "anthology", "codex", "other"];

[Parameter] public List<BookInfo> Books { get; set; } = [];
[Parameter] public bool Disabled { get; set; }
[Parameter] public string? Placeholder { get; set; }

/// <summary>
/// The filename the parent wants selected. When the parent changes this
/// (e.g. a chip is clicked) the box shows that book's title.
/// </summary>
[Parameter] public string? SelectedFilename { get; set; }

/// <summary>Parent flips this to a fresh value to force a clear.</summary>
[Parameter] public string? ExternalClearSignal { get; set; }

[Parameter] public EventCallback<string?> OnBookSelected { get; set; }

private string _text = "";
private string? _selectedFilename;
private string? _lastParamFilename;
private string? _lastClearSignal;
private bool _initialised;
private bool _open;

protected override void OnParametersSet()
{
if (!_initialised)
{
_initialised = true;
_lastClearSignal = ExternalClearSignal;
_lastParamFilename = null;
}

if (ExternalClearSignal != _lastClearSignal)
{
_lastClearSignal = ExternalClearSignal;
_selectedFilename = null;
_lastParamFilename = null;
_text = "";
_open = false;
return;
}

// Parent pushed a different book in -> mirror it in the box.
if (SelectedFilename != _lastParamFilename)
{
_lastParamFilename = SelectedFilename;
_selectedFilename = SelectedFilename;
_text = TitleFor(SelectedFilename);
_open = false;
}
}

private string TitleFor(string? filename)
{
if (string.IsNullOrWhiteSpace(filename))
{
return "";
}

return Books.FirstOrDefault(b => b.Filename == filename)?.Title ?? "";
}

private List<BookInfo> Results
{
get
{
var tokens = (_selectedFilename is not null ? "" : _text)
.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

return Books
.Where(b => tokens.All(t =>
(b.Title?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
(b.Author?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
(b.Series?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)))
.OrderBy(b => b.Title)
.Take(MaxResults)
.ToList();
}
}

private static string BadgeKey(BookInfo book)
{
var raw = !string.IsNullOrWhiteSpace(book.Type) ? book.Type : book.Category;
var key = (raw ?? "").Trim().ToLowerInvariant().Replace(' ', '_').Replace('-', '_');

if (KnownBadges.Contains(key))
{
return key;
}

return book.IsHorusHeresy ? "horus_heresy" : "other";
}

private void OpenList() => _open = true;

private void CloseList() => _open = false;

private async Task HandleInput(ChangeEventArgs e)
{
_text = e.Value?.ToString() ?? "";
_open = true;

// Typing over a selected book deselects it, so the box and the real
// filter can never disagree.
if (_selectedFilename is not null)
{
_selectedFilename = null;
_lastParamFilename = null;
await OnBookSelected.InvokeAsync(null);
}
}

private async Task HandleKeyDown(KeyboardEventArgs e)
{
if (e.Key == "Escape")
{
_open = false;
}
else if (e.Key == "Enter" && _open)
{
var first = Results.FirstOrDefault();
if (first is not null)
{
await Choose(first);
}
}
}

private async Task Choose(BookInfo book)
{
_selectedFilename = book.Filename;
_lastParamFilename = book.Filename;
_text = book.Title;
_open = false;
await OnBookSelected.InvokeAsync(book.Filename);
}

private async Task ClearSelection()
{
var hadSelection = _selectedFilename is not null;
_text = "";
_selectedFilename = null;
_lastParamFilename = null;
_open = false;

if (hadSelection)
{
await OnBookSelected.InvokeAsync(null);
}
}
}
