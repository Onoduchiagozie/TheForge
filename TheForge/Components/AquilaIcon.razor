    </g>
</svg>

@code {
    /// <summary>Rendered width in pixels; height follows the artwork's 688:290 aspect ratio.</summary>
    [Parameter] public int Size { get; set; } = 48;

    /// <summary>Applies the slow rotation used for the streaming/pipeline-progress state.</summary>
    [Parameter] public bool Spinning { get; set; } = false;

    /// <summary>Any extra HTML attributes (class, style, aria-label, title...) are forwarded to the svg.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
