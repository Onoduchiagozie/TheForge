@page "/"
@layout ForgeLayout
@rendermode InteractiveServer
@implements IDisposable
@using System.Text
@using TheForge.Models.UI
@using System.Text.Json
@inject IForgeApiService ForgeApi
@inject IThemeService ThemeService
@inject NavigationManager Nav
@inject ILogger<QueryWorkspace> Logger

<PageTitle>Warhammer</PageTitle>

<ErrorBoundary>
    <div class="workspace">

        @if (_showOfflineModal)
        {
            <div class="offline-modal-backdrop" @onclick="() => _showOfflineModal = false">
                <div class="offline-modal" @onclick:stopPropagation="true">
                    <p class="offline-modal__title">ARCHIVE OFFLINE</p>
                    <p class="offline-modal__body">
                        The Skald link  is down. Access has to  be requested manually.
                    </p>
                    <div class="offline-modal__actions">
                        <a class="request-access-btn" href="@WhatsAppRequestUrl" target="_blank" rel="noopener">
                            REQUEST ACCESS
                        </a>
                        <button type="button" class="offline-modal__dismiss" @onclick="() => _showOfflineModal = false">
                            DISMISS
                        </button>
                    </div>
                </div>
            </div>
        }

        <header class="status-bar @(_streamState == StreamState.Streaming ? "status-bar--streaming" : "")">
            <span class="status-dot @(IsHealthOnline ? "status-dot--online" : "status-dot--offline")"></span>
            <span class="status-item status-item--health">@HealthStatusLabel</span>
            <span class="status-item status-item--model">@HealthModelText</span>
            <span class="status-item status-item--chunks">@ChunkText</span>
            <span class="status-item status-item--books">@BookCountText</span>
            <span class="status-separator"></span>
            <span class="status-item status-item--retrieval">@RetrievalStrategyText</span>
            <span class="status-item">@ModeLabelText</span>
            <button class="status-link" type="button" @onclick="NavigateToSceneArchive">Scene Archive</button>
        </header>

        <main class="workspace-body">
            <section class="brand-panel">
                <div class="brand-panel__identity">
                    <AquilaIcon Size="56" />
                    <div>
                        <h1>Skald</h1>
                        <p class="subtitle">Relive the moment, With lore-accurate facts across the entire Warhammer40k universe.</p>
                        <p class="subtitle subtitle--secondary">
                            Great for fandom content creation, or re-reading & going back to a favourite passage without hunting for the exact
                            chapter or page,  just describe the scene the way you remember it.
                        </p>
                    </div>
                </div>
                <div class="mode-selector-wrap">
                    <div class="mode-selector" aria-label="Workspace mode">
                        <button type="button" class="@ModeButtonClass(WorkspaceMode.Narrator)" @onclick="() => SetMode(WorkspaceMode.Narrator)">
                            <svg class="mode-btn__icon" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path d="M4 5c3-1.5 6-1.5 8 0v14c-2-1.5-5-1.5-8 0V5z"/><path d="M20 5c-3-1.5-6-1.5-8 0v14c2-1.5 5-1.5 8 0V5z"/></svg>
                            Narrator
                        </button>
                        <button type="button" class="@ModeButtonClass(WorkspaceMode.Explorer)" @onclick="() => SetMode(WorkspaceMode.Explorer)">
                            <svg class="mode-btn__icon" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                            Explorer
                        </button>
                    </div>
                    <p class="mode-caption">@ModeCaptionText</p>
                </div>
            </section>

            <section class="query-panel">
                <label class="query-label" for="query-text">QUERY</label>
                <textarea id="query-text"
                          class="query-input"
                          placeholder="@QueryPlaceholder"
                          disabled="@(_streamState == StreamState.Streaming)"
                          @bind="_queryText"
                          @bind:event="oninput"></textarea>

                <div class="chip-row" role="group" aria-label="Example queries">
                    @foreach (var chip in ActiveChips)
                    {
                        <button type="button"
                                class="chip"
                                disabled="@(_streamState == StreamState.Streaming)"
                                @onclick="() => FillQuery(chip)">
                            "@chip"
                        </button>
                    }
                </div>

                <div class="filter-row">
                    <label for="book-filter">BOOK FILTER</label>
                    <div class="filter-input-wrap">
                        <svg class="filter-input__icon" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true"><path d="M4 4h4v16H4zM10 4h4v16h-4zM16 5l4-1v16l-4 1z"/></svg>
                        <input id="book-filter"
                               class="filter-input"
                               list="book-filter-options"
                               placeholder="@BookFilterPlaceholder"
                               @bind="_bookFilter"
                               @bind:event="oninput" />
                        <datalist id="book-filter-options">
                            @if (_sourceList is not null)
                            {
                                @foreach (var source in _sourceList.Sources)
                                {
                                    <option value="@source"></option>
                                }
                            }
                        </datalist>
                    </div>
                </div>

                <div class="query-actions">
                    <button type="button" class="submit-btn" disabled="@SubmitDisabled" @onclick="HandleSubmit">
                        @SubmitLabel
                    </button>
                    @if (_streamState == StreamState.Streaming)
                    {
                        <button type="button" class="stop-btn" @onclick="StopStream">STOP</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <p class="error-message">@_errorMessage</p>
                }
            </section>

            @if (_streamState == StreamState.Streaming && _mode == WorkspaceMode.Narrator)
            {
                <div class="pipeline-progress" aria-live="polite">
                    <AquilaIcon Size="44" Spinning="true" />

                    <div class="pipeline-progress__body">
                        <div class="pipeline-progress__track">
                            <div class="pipeline-progress__fill" style="width:@(_stage.ProgressPercent())%"></div>
                        </div>
                        <div class="pipeline-progress__label">
                            <span class="pipeline-progress__text">@_stage.Label()</span>
                            <span class="pipeline-progress__pct">@_stage.ProgressPercent()%</span>
                        </div>
                    </div>
                </div>
            }

            @if (_mode == WorkspaceMode.Explorer && _streamState == StreamState.Streaming)
            {
                <div class="scan-loading" aria-hidden="true">
                    <div class="scan-loading__bar"></div>
                </div>
            }

            <section class="@ResponsePanelClass">
                @switch (_streamState)
                {
                    case StreamState.Idle:
                        <div class="idle-state">
                            <span class="idle-text">@IdleText</span><span class="idle-cursor" aria-hidden="true"></span>
                        </div>
                        break;
                    case StreamState.Streaming:
                        <pre class="response-text">@_responseText@if (_mode == WorkspaceMode.Narrator)
                            {
                                <span class="cursor" aria-hidden="true"></span>
                            }</pre>
                        break;
                    case StreamState.Complete:
                        if (IsEmptyResult)
                        {
                            <div class="empty-state">
                                <p class="empty-state__headline">No records found</p>
                                <p class="empty-state__hint">
                                    @(string.IsNullOrWhiteSpace(_bookFilter)
                                        ? "Try rephrasing your query."
                                        : "Try removing the book filter or rephrasing your query.")
                                </p>
                            </div>
                        }
                        else if (_mode == WorkspaceMode.Explorer && _explorerSections.Count > 0)
                        {
                            foreach (var sectionz in _explorerSections)
                            {
                                <article class="explorer-section">
                                    <p>@sectionz</p>
                                </article>
                            }
                        }
                        else
                        {
                            <pre class="response-text">@_responseText<span class="complete-mark" aria-hidden="true">■</span></pre>
                        }
                        break;
                    case StreamState.Error:
                        <p class="response-error">@_errorMessage</p>
                        break;
                    case StreamState.Cancelled:
                        <pre class="response-text">@_responseText <span class="interrupted">[STREAM INTERRUPTED]</span></pre>
                        break;
                }
            </section>

            @if (_sourcesVisible)
            {
                <section class="sources-panel">
                    <div class="sources-header">
                        <span>SOURCES</span>
                        <span class="source-count">@_sources.Count</span>
                    </div>
                    <div class="source-list">
                        @foreach (var source in _sources)
                        {
                            <article class="source-card">
                                <strong>@SourceDisplayName(source)</strong>
                                @if (!string.IsNullOrWhiteSpace(source.Chapter) &&
                                     !source.Chapter.Equals("unknown", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>Chapter @source.Chapter</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(source.StitchRange))
                                {
                                    <span>Chunks @source.StitchRange</span>
                                }
                                <div class="confidence-bar" aria-label="Source confidence">
                                    <div class="confidence-fill" style="width: @ConfidenceWidth(source.Score)"></div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </main>
    </div>
</ErrorBoundary>

@code {
    private WorkspaceMode _mode = WorkspaceMode.Narrator;
    private string _queryText = "";
    private string _bookFilter = "";
    private string? _errorMessage;
    private StreamState _streamState = StreamState.Idle;
    private readonly StringBuilder _responseBuffer = new();
    private string _responseText = "";
    private CancellationTokenSource? _cts;
    private List<SourceInfo> _sources = [];
    private bool _sourcesVisible;
    private QueryStage _stage = QueryStage.Idle;
    private HealthPayload? _health;
    private bool _healthLoaded;
    private SourceListPayload? _sourceList;
    private bool _sourcesLoaded;
    private List<string> _explorerSections = [];
    private bool _showOfflineModal;
    private string[] _narratorActiveChips = [];
    private string[] _explorerActiveChips = [];

    private const string RetrievalStrategyText = "Retreival:BM25+Vector";

    // TODO: replace with your real WhatsApp number (digits only, country code, no + or spaces)
    // and whatever message you want pre-filled when someone taps "REQUEST ACCESS".
    private const string WhatsAppNumber = "+2347055260700";
    private const string WhatsAppMessage = "Hi, requesting access to The Cogitator .";

    private string WhatsAppRequestUrl =>
        $"https://wa.me/{WhatsAppNumber}?text={Uri.EscapeDataString(WhatsAppMessage)}";

    // 20-entry pools per mode. Narrator prompts are "tell me the story of..." style —
    // no book name needed. Explorer prompts are entity/topic names for raw ranked scenes.
    // Verify these against your own /explore endpoint before treating the list as final;
    // Claude has no visibility into which of your 340 indexed books actually cover each beat.
    private static readonly string[] NarratorPromptPool =
    [
    
   
        "Fulgrim's sensations as the daemon in the blade took hold while dueling his brother Ferrus Manus",
     
        "Leman Russ fights Magnus on prospero",
 
        "emperor's children Kakophoni use sonic weapon against white scars",
        "the destruction of Prospero",
        "Lorgar transforming angron as he fights gulliman on nuceria",
         "the World Eaters' massacre at Nuceria",
        "Magnus crashes wards on the imperial palace "
    ];

    private static readonly string[] ExplorerPromptPool =
    [
       
   "why did horus turn traitor"
    ];

    private string[] ActiveChips => _mode == WorkspaceMode.Explorer ? _explorerActiveChips : _narratorActiveChips;

    private bool SubmitDisabled => string.IsNullOrWhiteSpace(_queryText) || _streamState == StreamState.Streaming;
    private bool IsHealthOnline => _health is not null && !string.Equals(_health.Status, "error", StringComparison.OrdinalIgnoreCase);

    // Falls back to whatever the backend actually reports, so this never drifts
    // out of sync with a third health value (e.g. "degraded") the backend adds later.
    private string HealthStatusLabel => _health?.Status?.ToUpperInvariant() switch
    {
        null => "OFFLINE",
        "OK" or "HEALTHY" => "ONLINE",
        "ERROR" => "OFFLINE",
        var other => other
    };

    private string HealthModelText => string.IsNullOrWhiteSpace(_health?.OllamaModel) ? "" : _health.OllamaModel;

    // Only ever shows a real number or a plain, honest "loading" word — never a bare "--".
    private string? ChunkCountDisplay => _healthLoaded && _health?.MetadataLoaded is > 0
        ? _health.MetadataLoaded.ToString("N0")
        : null;
    private string ChunkText => ChunkCountDisplay is null ? "CHUNKS —" : $"{ChunkCountDisplay} CHUNKS";

    // Total falls back to the raw source-list length in case the backend ever
    // returns Total=0 for an unpaginated/short list rather than omitting it.
    private int? BookCount => _sourcesLoaded && _sourceList is not null
        ? (_sourceList.Total > 0 ? _sourceList.Total : _sourceList.Sources.Count)
        : null;
    private string BookCountText => BookCount is > 0 ? $"{BookCount:N0} BOOKS" : "BOOKS —";

    private string BookFilterPlaceholder => ChunkCountDisplay is null
        ? "Optional source title"
        : $"Narrows the {ChunkCountDisplay}-chunk pool to one book";

    private string ModeLabelText => _mode == WorkspaceMode.Explorer ? "EXPLORER" : "NARRATOR";
    private string ModeCaptionText => "Narrator answers in prose with citations. Explorer returns raw ranked scenes.";

    private string SubmitLabel => (_mode, _streamState) switch
    {
        (WorkspaceMode.Explorer, StreamState.Streaming) => "ANALYSING…",
        (WorkspaceMode.Explorer, _) => "ANALYSE",
        (_, StreamState.Streaming) => "CHRONICLING…",
        _ => "CHRONICLE"
    };

    private string IdleText => _mode == WorkspaceMode.Explorer ? "Input a designation for analysis..." : "The archive awaits your query...";

    private bool IsEmptyResult => _streamState == StreamState.Complete
        && string.IsNullOrWhiteSpace(_responseText)
        && (_mode != WorkspaceMode.Explorer || _sources.Count == 0);

    private string ResponsePanelClass => _mode == WorkspaceMode.Explorer
        ? "response-panel response-panel--explorer"
        : "response-panel response-panel--narrator";

    private string QueryPlaceholder => _mode == WorkspaceMode.Explorer
        ? "Try: \"What Corrupted the emperors children\" or \"Why Did Horus Turn traitor\""
        : "Horus Virus Bombs the Loyalists";

    protected override async Task OnInitializedAsync()
    {
        ThemeService.ApplyModeTheme(_mode);
        _narratorActiveChips = PickThree(NarratorPromptPool);
        _explorerActiveChips = PickThree(ExplorerPromptPool);
        await Task.WhenAll(LoadHealthAsync(), LoadSourcesAsync());
    }

    // Random-without-replacement pick of 3, so the chip row never shows a duplicate.
    private static string[] PickThree(string[] pool)
    {
        return pool.OrderBy(_ => Random.Shared.Next()).Take(3).ToArray();
    }

    private async Task LoadHealthAsync()
    {
        _health = await ForgeApi.GetHealthAsync();
        _healthLoaded = true;
    }

    private async Task LoadSourcesAsync()
    {
        _sourceList = await ForgeApi.GetSourcesAsync();
        _sourcesLoaded = true;
    }

    private void SetMode(WorkspaceMode mode)
    {
        if (_streamState == StreamState.Streaming)
        {
            return;
        }

        _mode = mode;
        ThemeService.ApplyModeTheme(_mode);
        ResetResponseState();
    }

    private string ModeButtonClass(WorkspaceMode mode)
    {
        return _mode == mode ? "mode-btn mode-btn--active" : "mode-btn mode-btn--inactive";
    }

    private void FillQuery(string text)
    {
        if (_streamState == StreamState.Streaming)
        {
            return;
        }

        _queryText = text;
    }

    private async Task HandleSubmit()
    {
        if (SubmitDisabled)
        {
            return;
        }

        // Checked here rather than at page load: firing this on every visit would be
        // noisy if the backend blips for a second. Only surface it when someone is
        // actually blocked from doing something, i.e. right when they try to submit.
        if (!IsHealthOnline)
        {
            _showOfflineModal = true;
            return;
        }

        ResetResponseState();
        var request = BuildQueryRequest();

        if (_mode == WorkspaceMode.Explorer)
        {
            await HandleExplorerQuery(request);
            return;
        }

        await HandleNarratorStream(request);
    }

    private QueryRequest BuildQueryRequest()
    {
        return new QueryRequest
        {
            Query = _queryText.Trim(),
            BookFilter = string.IsNullOrWhiteSpace(_bookFilter) ? null : _bookFilter.Trim()
        };
    }

    private void AppendStreamChunk(string chunk)
    {
        if (string.IsNullOrEmpty(chunk))
        {
            return;
        }

        // No manual space-guessing needed anymore — the token itself already
        // carries its own leading space when the model intends a new word,
        // because HandleNarratorStream no longer strips it. Just append raw.
        _responseBuffer.Append(chunk);
    }

    private async Task HandleNarratorStream(QueryRequest request)
    {
        _cts = new CancellationTokenSource();
        _streamState = StreamState.Streaming;

        try
        {
            using var response = await ForgeApi.BeginNarrateStreamAsync(request, _cts.Token);
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await response.Content.ReadAsStringAsync(_cts.Token);
                _streamState = StreamState.Error;
                return;
            }

            await using var stream = await response.Content.ReadAsStreamAsync(_cts.Token);
            using var reader = new StreamReader(stream);

            while (!_cts.Token.IsCancellationRequested)
            {
                var line = await reader.ReadLineAsync(_cts.Token);
                if (line is null)
                {
                    break;
                }

                if (!line.StartsWith("data:", StringComparison.Ordinal))
                {
                    continue;
                }

                // Strip only the single space the SSE framing convention adds right
                // after "data:" (data:<space><token>) — NOT a full .Trim(). The
                // model's tokenizer uses a leading space ON THE TOKEN ITSELF to mean
                // "this starts a new word." A previous .Trim() here destroyed that
                // signal, so every token looked the same whether or not it was meant
                // to attach to the previous word — that's what caused "Kh arn"
                // instead of "Kharn".
                var data = line["data:".Length..];
                if (data.StartsWith(' '))
                {
                    data = data[1..];
                }

                // Control frames ([DONE], [ERROR], __STAGE__, __SOURCES__) are exact
                // sentinel strings, not narrative text — safe to compare against a
                // separately trimmed copy without losing anything meaningful.
                var trimmedData = data.Trim();

                if (trimmedData == "[DONE]")
                {
                    _streamState = StreamState.Complete;
                    _stage = QueryStage.Complete;
                    break;
                }

                if (trimmedData.StartsWith("[ERROR]", StringComparison.Ordinal))
                {
                    _errorMessage = trimmedData["[ERROR]".Length..].Trim();
                    _streamState = StreamState.Error;
                    _stage = QueryStage.Error;
                    break;
                }

                if (trimmedData.StartsWith("__STAGE__:", StringComparison.Ordinal))
                {
                    _stage = QueryStageExtensions.Parse(trimmedData["__STAGE__:".Length..]);
                }
                else if (trimmedData.StartsWith("__SOURCES__:", StringComparison.Ordinal))
                {
                    ParseSourcesFrame(trimmedData);
                }
                else
                {
                    // Raw, untrimmed data — preserves the tokenizer's own
                    // word-boundary spacing exactly as the model intended it.
                    AppendStreamChunk(data);
                    _responseText = _responseBuffer.ToString();
                }
                await InvokeAsync(StateHasChanged);
            }

            if (_cts.Token.IsCancellationRequested && _streamState == StreamState.Streaming)
            {
                _streamState = StreamState.Cancelled;
            }
            else if (_streamState == StreamState.Streaming)
            {
                _streamState = StreamState.Complete;
            }
        }
        catch (OperationCanceledException)
        {
            _streamState = StreamState.Cancelled;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Narrator stream failed.");
            _errorMessage = "The archive stream failed before completion.";
            _streamState = StreamState.Error;
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleExplorerQuery(QueryRequest request)
    {
        _streamState = StreamState.Streaming;

        try
        {
            var result = await ForgeApi.QueryExploreAsync(request);
            if (result is null)
            {
                _errorMessage = "Analysis failed. The archive returned no data.";
                _streamState = StreamState.Error;
                return;
            }

            _responseText = result.Response;
            _responseBuffer.Append(result.Response);
            _sources = result.Sources;
            _sourcesVisible = _sources.Count > 0;
            ParseExplorerSections();
            _streamState = StreamState.Complete;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Explorer query failed.");
            _errorMessage = "Explorer analysis failed.";
            _streamState = StreamState.Error;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopStream()
    {
        _cts?.Cancel();
    }

    private void NavigateToSceneArchive()
    {
        Nav.NavigateTo("/archive");
    }

    private void ParseSourcesFrame(string data)
    {
        var json = data["__SOURCES__:".Length..];
        try
        {
            _sources = JsonSerializer.Deserialize<List<SourceInfo>>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? [];
            _sourcesVisible = _sources.Count > 0;
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "Malformed source frame ignored.");
        }
    }

    private void ParseExplorerSections()
    {
        _explorerSections = _responseText
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries)
            .Select(section => section.Trim())
            .Where(section => section.Length > 0)
            .ToList();
    }
    private void ResetResponseState()
    {
        _responseBuffer.Clear();
        _responseText = "";
        _sources.Clear();
        _sourcesVisible = false;
        _explorerSections.Clear();
        _errorMessage = null;
        _streamState = StreamState.Idle;
        _stage = QueryStage.Idle;
    } 

    private static string SourceDisplayName(SourceInfo source)
    {
        return string.IsNullOrWhiteSpace(source.Source) ? "Unknown source" : Path.GetFileName(source.Source);
    }

    private static string ConfidenceWidth(double score)
    {
        return $"{Math.Clamp(score * 100, 0, 100):0}%";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}