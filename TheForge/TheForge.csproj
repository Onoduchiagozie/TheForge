<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>TheForge</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude the test project that lives inside this folder -->
        <Compile Remove="ForgeLiveTests\**" />
        <Content Remove="ForgeLiveTests\**" />
        <EmbeddedResource Remove="ForgeLiveTests\**" />
        <None Remove="ForgeLiveTests\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- API docs -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
        <!-- EF Core + SQLite -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- JWT auth -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.4" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Tests\" />
    </ItemGroup>
</Project>
