@page "/archive"
@layout ForgeLayout
@inject ISceneArchiveService SceneArchiveService
@inject ILogger<SceneArchivePage> Logger

<PageTitle>WarHammer Scene Bank</PageTitle>

<div class="scene-archive" role="main" aria-label="Battle Scene Archive">
    <header class="scene-archive__header">
        <div>
             <h1 class="scene-archive__title">The Memoria</h1>
            <AquilaIcon Size="150"/>
            <p class="scene-archive__subtitle">
                    @* An index of algorithmically woven Warhammer 40,000 battle chronicles, assembled *@ 

                Over a thousand Warhammer lore materials, AI extracted and vector-ranked to surface the most intense moments. Search anything and jump straight into the action
                @*     from the wider Black Library catalog and ranked by narrative score. Browse the *@
                @*     rows below or search the archive directly for a character, location, or event. *@
            </p>
        </div>
        <div class="scene-archive__header-actions">
            <ArchiveLinkStatus />
            <a href="/" class="scene-archive__workspace-link">Query Terminal →</a>
        </div>
    </header>

    <div class="scene-archive__search-bar">
        <SceneSearchBar Query="@_searchQuery"
                         QueryChanged="OnSearchQueryChanged"
                         OnSearch="RunSearch"
                         OnClear="ClearSearch" />
    </div>

    @if (_activeSearchQuery is not null)
    {
        <div class="scene-archive__search-results">
            @if (_searchLoading)
            {
                <div class="scene-archive__terminal-loading" aria-live="polite" aria-label="Searching">
                    <p>&gt; querying scene bank for "@_activeSearchQuery"...</p>
                    <p class="scene-archive__terminal-cursor">&gt; _</p>
                </div>
            }
            else
            {
                <div class="scene-archive__search-header">
                    <p class="scene-archive__search-status">
                        &gt; @(_searchResults?.Count ?? 0) result(s) for "@_activeSearchQuery"
                    </p>
                    <button type="button" class="scene-archive__search-back" @onclick="ClearSearch">
                        ← Back to archive
                    </button>
                </div>

                @if (_searchResults is { Count: 0 })
                {
                    <p class="scene-archive__empty">No matching chronicles found in the scene bank.</p>
                }
                else if (_searchResults is not null)
                {
                    <div class="scene-archive__search-grid">
                        @foreach (var card in _searchResults)
                        {
                            <SceneCard Card="card" OnSelected="@(() => OpenOverlay(card.Id))" />
                        }
                    </div>
                }
            }
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="scene-archive__error" role="alert">@_loadError</div>
    }
    else if (_rows is null)
    {
        <div class="scene-archive__terminal-loading" aria-live="polite" aria-label="Loading archive">
            <p>&gt; establishing archive link...</p>
            <p>&gt; authenticating machine spirit...</p>
            <p>&gt; indexing woven chronicles...</p>
            <p class="scene-archive__terminal-cursor">&gt; _</p>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="scene-archive__empty">The archive link reports no indexed chronicles yet.</div>
    }
    else
    {
        @foreach (var row in _rows)
        {
            <SceneRow Row="row" OnCardSelected="OpenOverlay" />
        }
    }

    <footer class="scene-archive__footer">
        <div class="scene-archive__footer-stats">
            <span>@(_totalSceneCount?.ToString() ?? "—") chronicles indexed</span>
        </div>
        <div class="scene-archive__footer-note">
            <strong>Ranking:</strong> chronicles are ordered by a single narrative <code>score</code>
            (tie-broken by <code>rank</code>) computed during the weaving pipeline — there is no
            book/series weighting of any kind. The Top-Ranked row and the featured rotation
            reshuffle every 15 minutes using a weighted-random draw, so the same handful of
            highest scorers won't permanently occupy the front position.
        </div>
    </footer>
</div>

<SceneOverlay IsOpen="@_overlayOpen"
              Detail="@_overlayDetail"
              IsLoading="@_overlayLoading"
              ErrorMessage="@_overlayError"
              OnClose="CloseOverlay" />

@code {
    private List<SceneRowViewModel>? _rows;
    private string? _loadError;
    private int? _totalSceneCount;

    private bool _overlayOpen;
    private bool _overlayLoading;
    private string? _overlayError;
    private SceneDetailViewModel? _overlayDetail;

    private string _searchQuery = string.Empty;
    private string? _activeSearchQuery;
    private bool _searchLoading;
    private List<SceneCardSummary>? _searchResults;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = await SceneArchiveService.GetLandingRowsAsync();
            _totalSceneCount = await SceneArchiveService.GetTotalSceneCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load scene archive landing rows");
            _loadError = "ARCHIVE LINK DEGRADED — unable to retrieve chronicles.";
        }
    }

    private void OnSearchQueryChanged(string value) => _searchQuery = value;

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        _activeSearchQuery = _searchQuery;
        _searchLoading = true;
        _searchResults = null;
        StateHasChanged();

        try
        {
            _searchResults = await SceneArchiveService.SearchScenesAsync(_activeSearchQuery);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Scene search failed for query {Query}", _activeSearchQuery);
            _searchResults = [];
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _activeSearchQuery = null;
        _searchResults = null;
    }

    private async Task OpenOverlay(int sceneId)
    {
        _overlayOpen = true;
        _overlayLoading = true;
        _overlayError = null;
        _overlayDetail = null;
        StateHasChanged();

        try
        {
            var detail = await SceneArchiveService.GetSceneDetailAsync(sceneId);
            if (detail is null)
            {
                _overlayError = "ARCHIVE RECORD NOT FOUND — this chronicle may have been reindexed.";
            }
            else
            {
                _overlayDetail = detail;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load scene detail {SceneId}", sceneId);
            _overlayError = "ARCHIVE LINK DEGRADED — unable to decrypt this record.";
        }
        finally
        {
            _overlayLoading = false;
        }
    }

    private void CloseOverlay()
    {
        _overlayOpen = false;
        _overlayDetail = null;
        _overlayError = null;
    }
}
