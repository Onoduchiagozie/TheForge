@implements IDisposable
@inject IThemeService ThemeService
@inject TheForge.Services.StaticAssetUrls StaticAssets

<!DOCTYPE html>
<html lang="en" style="@ThemeVariables">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@StaticAssets.VersionedPath("css/forge-base.css")" />
    <link rel="stylesheet" href="@StaticAssets.VersionedPath("css/scene-archive-theme.css")" />
    <link rel="stylesheet" href="@StaticAssets.VersionedPath("TheForge.styles.css")" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
<Routes @rendermode="InteractiveServer" />
<script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // HTML attributes decode quoted font names; raw <style> text does not.
    private string ThemeVariables => string.Join(";", ThemeService.GetCssVariables()
        .Select(variable => $"{variable.Key}: {variable.Value}"));

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
