@* SceneOverlay.razor
   Presentational only — SceneArchivePage owns fetching Detail/IsLoading/ErrorMessage.

   Every JS interop call below is wrapped in try/catch. Without that, a JS failure inside
   OnAfterRenderAsync throws unhandled, which kills the entire Blazor Server circuit — that's
   what caused the crash-on-every-click behavior seen earlier. With it, a JS failure just
   falls back to showing the chronicle text directly (no typewriter animation) instead of
   breaking the page.
*@
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ILogger<SceneOverlay> Logger
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="scene-overlay" role="dialog" aria-modal="true" aria-label="@(Detail?.Title ?? "Scene detail")" @onkeydown="HandleKeyDown">
        <div class="scene-overlay__backdrop" @onclick="Close"></div>

        <div class="scene-overlay__panel">
            <button type="button" class="scene-overlay__close" @onclick="Close" @ref="_closeButtonRef" aria-label="Close">
                ✕
            </button>

            @if (IsLoading)
            {
                <div class="scene-overlay__status" aria-live="polite">Decrypting archive record&hellip;</div>
            }
            else if (ErrorMessage is not null)
            {
                <div class="scene-overlay__status scene-overlay__status--error" role="alert">@ErrorMessage</div>
            }
            else if (Detail is not null)
            {
                <div class="scene-overlay__artwork" aria-hidden="true"></div>

                <div class="scene-overlay__seal">
                    <ArchiveSeal Size="72" />
                </div>

                <header class="scene-overlay__header">
                    <p class="scene-overlay__book">@Detail.BookTitle</p>
                    <h2 class="scene-overlay__title">@Detail.Title</h2>
                    <p class="scene-overlay__teaser">@Detail.Teaser</p>
                </header>

                <dl class="scene-overlay__metadata">
                    <div><dt>Category</dt><dd>@Detail.SceneType</dd></div>
                    <div><dt>Score</dt><dd>@Detail.Score.ToString("0.00")</dd></div>
                    <div><dt>Rank</dt><dd>@Detail.Rank</dd></div>
                    <div><dt>Woven</dt><dd>@(Detail.WovenAt ?? "unknown")</dd></div>
                </dl>

                @if (_jsAvailable)
                {
                    <div class="scene-overlay__chronicle" id="scene-overlay-chronicle"></div>
                }
                else
                {
                    <div class="scene-overlay__chronicle">@Detail.Chronicle</div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public SceneDetailViewModel? Detail { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private IJSObjectReference? _module;
    private int? _lastAnimatedSceneId;
    private ElementReference _closeButtonRef;
    private bool _pendingFocus;
    private bool _jsAvailable = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/SceneArchive/SceneOverlay.razor.js");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Scene overlay JS module failed to load — falling back to static chronicle text");
                _jsAvailable = false;
            }
        }

        if (_jsAvailable && _module is not null && IsOpen && Detail is not null && Detail.Id != _lastAnimatedSceneId)
        {
            _lastAnimatedSceneId = Detail.Id;
            try
            {
                // charsPerTick/tickMs tuned for a readable-but-not-glacial decrypt effect on
                // typical chronicle lengths; adjust freely, it's just two numbers.
                await _module.InvokeVoidAsync("startTypewriter", "scene-overlay-chronicle", Detail.Chronicle, 3, 18);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Typewriter playback failed for scene {SceneId} — falling back to static text", Detail.Id);
                _jsAvailable = false;
                StateHasChanged(); // switch the markup branch to the static fallback
            }
        }

        if (_pendingFocus)
        {
            _pendingFocus = false;
            try
            {
                await _closeButtonRef.FocusAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to focus overlay close button — non-critical, continuing");
            }
        }

        if (!IsOpen)
        {
            _lastAnimatedSceneId = null;
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _pendingFocus = true;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }

    private async Task Close()
    {
        if (_jsAvailable && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopTypewriter");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to stop typewriter on close — non-critical, continuing");
            }
        }

        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopTypewriter");
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // Circuit already gone, or the module never fully loaded — nothing to clean up.
            }
        }
    }
}
