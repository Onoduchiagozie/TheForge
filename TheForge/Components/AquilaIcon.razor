@* AquilaIcon.razor - reusable Imperial Aquila logo, traced from the supplied artwork.
   Colour comes from .aquila-icon in workspace.css (no fill attribute here, so CSS wins).
   Usage:  <AquilaIcon Size="56" />
           <AquilaIcon Size="44" Spinning="true" />
           <AquilaIcon Size="24" class="nav-logo" aria-label="Home" />   // extra attributes pass through *@

<svg @attributes="AdditionalAttributes"
     class="aquila-icon @(Spinning ? "aquila-icon--spinning" : "") @(AdditionalAttributes?.GetValueOrDefault("class"))"
     width="@Size"
     height="@(Size * 290 / 688)"
     viewBox="0 0 688 290"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="@(AdditionalAttributes?.ContainsKey("aria-label") == true ? null : "true")">
